generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  GLOBAL    // 글로벌
  STOCKS    // 증권
  AI        // AI
  POLICY    // 정부정책
  REALESTATE // 부동산
}

enum Urgency {
  breaking
  watch
  note
}

enum DigestStatus {
  pending
  in_progress
  done
  failed
}

// ─── 1. DailyDigest ──────────────────────────────────────────────────────────
model DailyDigest {
  id        String       @id @default(cuid())
  date      DateTime     @unique @db.Date
  status    DigestStatus @default(pending)
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  marketDaily         MarketDaily?
  categoryBriefings   CategoryBriefing[]
  newsItems           NewsItem[]
  personaRankResults  PersonaRankResult[]

  @@index([date])
  @@index([status])
  @@index([archived])
}

// ─── 2. MarketDaily ──────────────────────────────────────────────────────────
model MarketDaily {
  id       String   @id @default(cuid())
  digestId String   @unique
  date     DateTime @db.Date

  kospiValue    Float?
  kospiChange   String?
  kospiDir      String?
  kosdaqValue   Float?
  kosdaqChange  String?
  kosdaqDir     String?
  usdKrwValue   Float?
  usdKrwChange  String?
  usdKrwDir     String?
  wtiValue      Float?
  wtiChange     String?
  wtiDir        String?
  us10yValue    Float?
  us10yChange   String?
  us10yDir      String?
  btcUsdValue   Float?
  btcUsdChange  String?
  btcUsdDir     String?
  nasdaqValue   Float?
  nasdaqChange  String?
  nasdaqDir     String?

  createdAt DateTime @default(now())

  digest DailyDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@index([date])
}

// ─── 3. CategoryBriefing ─────────────────────────────────────────────────────
model CategoryBriefing {
  id        String   @id @default(cuid())
  digestId  String
  category  Category
  summary   String   @db.Text
  newsCount Int      @default(0)
  archived  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  digest    DailyDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)
  newsItems NewsItem[]

  @@unique([digestId, category])
  @@index([digestId])
  @@index([category])
  @@index([archived])
}

// ─── 4. NewsItem ─────────────────────────────────────────────────────────────
model NewsItem {
  id                 String   @id @default(cuid())
  digestId           String
  categoryBriefingId String
  category           Category
  newsOrder          Int

  title   String @db.Text
  urgency Urgency @default(note)

  fact   String @db.Text
  impact String @db.Text
  action String @db.Text

  contextTags String[]
  source      String
  sourceUrl   String   @db.Text

  isTop3   Boolean @default(false)
  top3Rank Int?

  relatedData    String[]
  contextLinks   String[]
  upcomingEvents String[]

  sourceCount      Int      @default(1)
  sourceList       String[]
  consensusFacts   String?  @db.Text
  conflictingFacts String?  @db.Text

  // CMP-131: archive flag + GitHub Trending fields
  archived          Boolean @default(false)
  isGithubTrending  Boolean @default(false)
  githubStarsDelta  Int?
  githubLanguage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  digest           DailyDigest      @relation(fields: [digestId], references: [id], onDelete: Cascade)
  categoryBriefing CategoryBriefing @relation(fields: [categoryBriefingId], references: [id], onDelete: Cascade)

  @@unique([digestId, category, newsOrder])
  @@index([digestId])
  @@index([category])
  @@index([urgency])
  @@index([isTop3])
  @@index([isGithubTrending])
  @@index([archived])
  @@index([contextTags])
}

// ─── 5. ContextTagHistory ────────────────────────────────────────────────────
model ContextTagHistory {
  id           String   @id @default(cuid())
  tag          String   @unique
  count        Int      @default(1)
  lastSeenDate DateTime @db.Date
  newsItemIds  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tag])
  @@index([count])
  @@index([lastSeenDate])
}

// ─── 6. WeeklyDigest ─────────────────────────────────────────────────────────
model WeeklyDigest {
  id        String   @id @default(cuid())
  weekStart DateTime @unique @db.Date
  weekEnd   DateTime @db.Date
  content   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekStart])
  @@index([weekEnd])
}

// ─── v4 Phase 0: Persona ─────────────────────────────────────────────────────
model Persona {
  id            String   @id @default(cuid())
  name          String   @unique
  role          String
  interests     Json     @default("[]")
  sourceWeights Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
}

// ─── v4 Phase 0: EntityStat (stub) ───────────────────────────────────────────
model EntityStat {
  id         String   @id @default(cuid())
  entityName String
  entityType String
  statDate   DateTime @db.Date
  metrics    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@unique([entityName, entityType, statDate])
  @@index([entityName])
  @@index([entityType])
  @@index([statDate])
}

// ─── Phase 3-C: A/B Evaluation ───────────────────────────────────────────────
model ABEvaluation {
  id          String   @id @default(cuid())
  evalDate    DateTime @db.Date
  personaName String
  choice      String   // "A" or "B"
  rationale   String   @db.Text
  snapshotA   Json     // news items shown as option A
  snapshotB   Json     // news items shown as option B
  scoresB     Json     // persona relevance scores for B items
  createdAt   DateTime @default(now())

  @@index([evalDate])
  @@index([choice])
  @@index([createdAt])
}

// ─── v4 Phase 0: WikiEntry (3-way split stub) ────────────────────────────────
enum WikiEntryType {
  ledger        // structured facts: entity, date, metric, source_url
  narrative     // human-readable summaries (weekly cadence)
  daily_digest  // daily briefing cache
}

model WikiEntry {
  id        String        @id @default(cuid())
  entryType WikiEntryType
  title     String
  body      String        @db.Text
  tags      String[]
  sourceUrl String?       @db.Text
  refDate   DateTime?     @db.Date
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([entryType])
  @@index([refDate])
  @@index([tags])
}

// ─── Phase 3-B: Persona-conditional LLM Rerank ───────────────────────────────
model PersonaRankResult {
  id               String   @id @default(cuid())
  digestId         String
  personaId        String   // "A" | "B" | "C"
  personaName      String
  rankedItems      Json     // [{newsItemId, rank, rationale}]
  clusterHeadlines Json     // [{headline, articleIds}]
  usedFallback     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  digest DailyDigest @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@unique([digestId, personaId])
  @@index([digestId])
  @@index([createdAt])
}

// ─── 부동산 수집 (2026-07-03): 국토부 실거래 + 청약홈 + 매물 스냅샷 ─────────────
model AptTrade {
  id         String   @id @default(cuid())
  lawdCd     String // 법정동코드 5자리 (11590 동작 등)
  dong       String // 법정동명
  aptName    String
  jibun      String?
  excluUseAr Float // 전용면적 ㎡
  floor      Int?
  dealDate   DateTime @db.Date
  dealAmount Int // 만원
  buildYear  Int?
  dealingGbn String? // 중개/직거래
  cdealType  String? // 해제여부
  createdAt  DateTime @default(now())

  @@unique([lawdCd, aptName, dealDate, excluUseAr, floor, dealAmount])
  @@index([dong, dealDate])
  @@index([dealDate])
}

model AptRent {
  id           String   @id @default(cuid())
  lawdCd       String
  dong         String
  aptName      String
  excluUseAr   Float
  floor        Int?
  dealDate     DateTime @db.Date
  deposit      Int // 만원
  monthlyRent  Int // 만원 (0 = 전세)
  contractType String? // 신규/갱신
  createdAt    DateTime @default(now())

  @@unique([lawdCd, aptName, dealDate, excluUseAr, floor, deposit, monthlyRent])
  @@index([dong, dealDate])
}

model SubscriptionNotice {
  id            String    @id @default(cuid())
  houseManageNo String
  noticeType    String // APT | 무순위
  houseName     String
  address       String?
  region        String? // 공급지역명 (서울 등)
  builder       String?
  totalSupply   Int?
  noticeDate    String? // 모집공고일
  rceptBegin    String?
  rceptEnd      String?
  winnerDate    String?
  url           String?
  raw           Json      @default("{}")
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([houseManageNo, noticeType])
  @@index([region, rceptBegin])
}

// 전수 스윕 결과 — 예산 내·300세대+·관심지역 아파트 후보
model ComplexCandidate {
  id            String   @id @default(cuid())
  complexNo     String   @unique
  name          String
  gu            String
  dong          String
  household     Int // 총 세대수
  elapsedYear   Int? // 준공 경과 연수
  approvalDate  String? // 준공일 YYYYMMDD
  totalArticles Int      @default(0) // 전체 매물 수
  dealArticles  Int      @default(0) // 매매 매물 수
  inBudgetCount Int      @default(0) // 예산 내 매매 매물 수
  minDealPrice  Int? // 최저 매매 호가(만원)
  maxDealPrice  Int? // 최고 매매 호가(만원)
  budgetCeiling Int // 이 스윕에 쓰인 예산 상한(만원)
  listings      Json     @default("[]") // 예산 내 매물 상세 [{price,area,floor,dong}]
  lat           Float? // 단지 위도(new.land API 백필) — 통근·상권 점수용
  lng           Float? // 단지 경도
  far           Float? // 용적률 %(new.land single-markers floorAreaRatio) — 재건축 사업성 지표
  sweptAt       DateTime @default(now())

  @@index([gu, dong])
  @@index([minDealPrice])
  @@index([household])
}

model ListingSnapshot {
  id           String   @id @default(cuid())
  complexNo    String
  complexName  String
  date         DateTime @db.Date
  tradeType    String   @default("A1")
  articleCount Int?
  minPrice     Int? // 만원
  maxPrice     Int? // 만원
  raw          Json     @default("{}")
  createdAt    DateTime @default(now())

  @@unique([complexNo, date, tradeType])
}

// ─── v4 Phase 1-A: Raw collected articles ─────────────────────────────────────
model Article {
  id          String    @id @default(cuid())
  title       String
  url         String    @unique
  sourceType  String
  category    String?
  content     String?   @db.Text
  publishedAt DateTime?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  @@index([sourceType])
  @@index([createdAt])
}

// 일일 매물 추천 발송 로그 — 로테이션(쿨다운)·변화 추적용
model SentRecommendation {
  id           String   @id @default(cuid())
  complexKey   String // "{lawdCd}|{dong}|{aptName}" 단지 식별
  name         String
  gu           String
  dong         String
  medianManwon Int // 발송 시점 실거래 중간값(만원) — 다음 발송 시 하락 감지 기준
  score        Int // 발송 시점 종합 점수
  scenario     String // "현행" | "완화"
  rank         Int // 그날 추천 순위
  reasons      Json     @default("[]")
  sentDate     String // "YYYY-MM-DD" (KST) — 날짜 단위 쿨다운 조회
  sentAt       DateTime @default(now())

  @@index([complexKey, sentDate])
  @@index([sentDate])
}
