<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.news-digest.naver-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/sklee01/news-digest/scripts/naver-sweep.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sklee01/news-digest</string>
  <!-- 1-B-ii 요일 분할: 일 03:00 = 기존 13구(sun) / 수 03:00 = 신규 12구(wed). 그룹은 naver-sweep.sh가 요일로 판별 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>0</integer>
      <key>Hour</key><integer>3</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>3</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key><string>/Users/sklee01/news-digest/output/naver_sweep.log</string>
  <key>StandardErrorPath</key><string>/Users/sklee01/news-digest/output/naver_sweep.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
