# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_digest"

# Ollama (local LLM — no Anthropic API key needed)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="gemma4:26b"

# Cron authentication (set a random secret; leave empty to disable auth in dev)
CRON_SECRET=""

# Slack webhook for digest notifications (optional)
SLACK_WEBHOOK_URL=""

# Base URL for internal API self-calls (used in cron routes)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
