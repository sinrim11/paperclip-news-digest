# News Digest Configuration
# Copy to .env and update values for your environment

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Local LLM (LM Studio OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=supergemma4-26b-uncensored-mlx-v2

# FastAPI Web Server
WEB_HOST=0.0.0.0
WEB_PORT=3200
PYTHONUNBUFFERED=1

# Application Settings
MAX_ARTICLES=50
TIMEOUT_SEC=300
LOG_LEVEL=info

# Database (if using)
DATABASE_URL=

# Optional: API Keys for external services
# NEWSAPI_KEY=
# RAPIDAPI_KEY=

# Deployment
ENVIRONMENT=development
DEBUG=false

# ── Next.js App (copy relevant lines to .env.local) ──────────────────────────

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_digest

# Anthropic Claude API (required — get key at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Cron job authentication — set a strong random secret in production
# Generate: openssl rand -hex 32
CRON_SECRET=change-me-in-production

# Slack webhook for digest notifications (optional)
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Base URL used by cron routes for internal self-calls
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
