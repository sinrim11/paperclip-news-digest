# News Digest 환경변수 예시
# 비밀값은 .env(gitignored)에 복사해서 사용. .env.local은 보드 관리(read-only 444).
# Next.js 우선순위: .env.local > .env

# ── LLM (LM Studio, OpenAI 호환) ─────────────────────────────────────────────
LLM_BASE_URL=http://localhost:1234/v1
# LM Studio 서버에 토큰 인증이 켜져 있음 — 앱 내 API 토큰 발급 후 설정 (필수)
LLM_API_KEY=sk-lm-...
LLM_MODEL=qwen3.6-35b-a3b-mlx

# ── Database (네이티브 PostgreSQL 16) ────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_digest

# ── 알림 ─────────────────────────────────────────────────────────────────────
# Telegram (BotFather에서 발급 — 구 토큰은 git 이력에 노출되어 회전 필수)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack Incoming Webhook (선택)
SLACK_WEBHOOK_URL=

# ── 헤드리스 Claude (주간 딥다이브 전용, 선택) ─────────────────────────────────
# ~/.zshrc에 이미 있으면 생략 가능 — 스크립트가 자동 로드함
# ANTHROPIC_AUTH_TOKEN=

# ── Cron ─────────────────────────────────────────────────────────────────────
# openssl rand -hex 32 로 생성. 비우면 인증 없이 호출 허용(dev)
CRON_SECRET=

# ── Base URL (크론 라우트의 내부 self-call용) ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3200
NEXT_PUBLIC_BASE_URL=http://localhost:3200
