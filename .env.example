# News Digest Configuration
# Copy to .env and update values for your environment

# Ollama/MLX Configuration
OLLAMA_API_URL=http://localhost:11434/v1/chat/completions
OLLAMA_FALLBACK_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=gemma4:26b
MLX_MODEL=mlx-community/gemma-2-2b-it
MLX_URL=http://localhost:8080/v1/chat/completions

# FastAPI Web Server
WEB_HOST=0.0.0.0
WEB_PORT=3200
PYTHONUNBUFFERED=1

# Application Settings
MAX_ARTICLES=50
TIMEOUT_SEC=300
LOG_LEVEL=info

# Database (if using)
DATABASE_URL=

# Optional: API Keys for external services
# NEWSAPI_KEY=
# RAPIDAPI_KEY=

# Deployment
ENVIRONMENT=development
DEBUG=false

# ── Next.js App (copy relevant lines to .env.local) ──────────────────────────

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_digest

# Ollama (OpenAI-compatible local LLM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:26b

# Cron job authentication — set a strong random secret in production
# Generate: openssl rand -hex 32
CRON_SECRET=change-me-in-production

# Slack webhook for digest notifications (optional)
# Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# Base URL used by cron routes for internal self-calls
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
